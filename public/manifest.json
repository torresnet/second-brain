{
  "name": "Segundo Cérebro AI",
  "short_name": "SecondBrain",
  "description": "Seu acervo inteligente e multimodal de conhecimento, anotações e mídias.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#090d16",
  "theme_color": "#0f172a",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "192x192 512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": [
            "application/pdf",
            "image/*",
            "audio/*",
            "video/*",
            "text/plain",
            "text/markdown",
            ".pdf",
            ".md",
            ".txt"
          ]
        }
      ]
    }
  }
}
